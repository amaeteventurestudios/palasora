# Palavva local (Mac) configuration. Copy to .env.local via scripts/setup-local.sh,
# which generates random secrets. NEVER commit real values.

# --- Policy gates (do not change without explicit founder approval) ---
ORACLE_DEPLOYMENT_AUTHORIZED=false
PUBLIC_LAUNCH_AUTHORIZED=false
PAID_FALLBACKS_ENABLED=false

# --- Data location (dev and test datasets are kept separate) ---
PALAVVA_DATA_DIR=./data
PALAVVA_ENV=development            # development | test

# --- PocketBase (loopback only) ---
PB_URL=http://127.0.0.1:8190
PB_SERVICE_EMAIL=service@palavva.local
PB_SERVICE_PASSWORD=__generated__
PB_WORKER_EMAIL=worker@palavva.local
PB_WORKER_PASSWORD=__generated__
# Password for local seeded accounts (editor@palavva.local, reader@palavva.local, admin@sample.local, ...)
LOCAL_DEMO_PASSWORD=__generated__

# --- Web ---
WEB_ORIGIN=http://127.0.0.1:3000
# Trusted host -> tenant slug allowlist. Unknown hosts get a generic 404.
TENANT_HOSTS='{"127.0.0.1:3000":"palavva","localhost:3000":"palavva","sample.localhost:3000":"sample-community"}'
SESSION_TTL_DAYS=14
SHOW_DEMO_CONTENT=true
REQUIRE_EMAIL_VERIFICATION=true

# --- Editorial worker ---
EDITORIAL_URL=http://127.0.0.1:8100
EDITORIAL_SERVICE_TOKEN=__generated__
# Model provider: ollama | fixture. "fixture" is deterministic test output, never real editorial.
MODEL_PROVIDER=ollama
OLLAMA_URL=http://100.70.149.32:11434
OLLAMA_MODEL=qwen3.5:4b
MODEL_MAX_CONCURRENCY=1
MODEL_TIMEOUT_SEC=90
MODEL_DAILY_REQUEST_BUDGET=60
CONVERSATION_DAILY_REPLY_BUDGET=150
# Cloud adapters exist but are disabled; enabling requires PAID_FALLBACKS_ENABLED=true AND a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Kill switches (initial defaults) ---
INGEST_PAUSED=false
AI_PAUSED=false
AUTO_PUBLISH_DISABLED=true
AD_SLOTS_DISABLED=false

# --- Palasora Phase 1 (docs/PHASE-1-REPORT.md) ---
# News is retired: no RSS ingestion, no discovery runner, no news discussions, and news is hidden from every public
# surface (stored, not deleted; staff still see it in the Command Center). Set to false only to roll back.
NEWS_RETIRED=true
# People post, reply and vote. The kill switch is the tenant switch HUMAN_WRITES_PAUSED (Command Center > Settings), default off.

# --- External integrations (no credentials configured => adapters report NOT_CONFIGURED) ---
ESPOCRM_URL=
ESPOCRM_API_KEY=
REVIVE_DELIVERY_URL=

# --- v1.3 locale / conversations ---
# Name of a header set by a trusted edge proxy carrying ISO country (e.g. cf-ipcountry). Empty = no country inference.
TRUSTED_GEO_HEADER=
DEMO_THREADS_ENABLED=true

# v1.8+ ISSUE-23/24 users, access and email
ACCESS_ENCRYPTION_KEY=          # 64 hex chars; encrypts staff MFA secrets (generated by setup-local.sh; required in production)
STAFF_MFA_REQUIRED=true         # second sign-in step for Super Admin / Admin / Finance and anyone with sensitive permissions (always on in production)
MAIL_TRANSPORT=sink             # sink = development mail sink (files under data/mail-sink). smtp is refused until MAIL_LIVE_AUTHORIZED=true
MAIL_LIVE_AUTHORIZED=false      # founder approval for any outside email (provider + SPF/DKIM/DMARC first)
# SMTP_HOST= SMTP_USER= SMTP_PASSWORD=   (only after a provider is approved)
# ADMIN_HOSTS=                  # admin hostname is UNRESOLVED: admin.palava.com (requested) vs admin.palavva.com (earlier plan); confirm before DNS
